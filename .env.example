# Copy via uv run project-init. Development only; JSON arrays for list fields.
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_PROJECT_NAME=Python Backend
APP_PUBLIC_URL=http://localhost:8000
APP_DATABASE__URL=postgresql+asyncpg://app:app@localhost:5432/app
APP_DATABASE__POOL_SIZE=5
APP_DATABASE__MAX_OVERFLOW=5
APP_DATABASE__POOL_TIMEOUT=5
APP_DATABASE__READINESS_TIMEOUT=2
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_REQUEST_TIMEOUT=30
APP_MAX_REQUEST_BYTES=1048576
APP_LOGGING__LEVEL=INFO
APP_LOGGING__ACCESS=true
APP_AUTH__ISSUER=
APP_AUTH__AUDIENCE=
APP_AUTH__JWKS_URL=
APP_AUTH__ALGORITHMS=["RS256"]
APP_AUTH__CLOCK_SKEW=30
APP_AUTH__CACHE_TTL=300
APP_AUDIT__ENABLED=true
APP_AUDIT__RETENTION_DAYS=90
APP_AUDIT__MAX_PAYLOAD_BYTES=4096
APP_BUILD_VERSION=0.1.0
APP_GIT_SHA=unknown
# Optional: APP_EMAIL__PROVIDER, APP_EMAIL__API_KEY, APP_EMAIL__FROM_ADDRESS
# Optional named integrations: APP_INTEGRATIONS={"name":{"base_url":"https://...","timeout":5}}
